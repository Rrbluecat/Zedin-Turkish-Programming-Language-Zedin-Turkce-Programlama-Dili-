aktar "interpreter.zed";

degisken kod = "fonk selam(isim) { don isim; }";
degisken tokenlar = tara(kod);
degisken ast = parse(tokenlar);
degisken fonk_stmt = ast[0];
yaz "tip: " + fonk_stmt[0];
yaz "isim: " + fonk_stmt[1];
yaz "params: " + metine(fonk_stmt[2]);
yaz "blok tip: " + fonk_stmt[3][0];
yaz "blok uzunluk: " + metine(uzunluk(fonk_stmt[3][1]));
