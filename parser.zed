degisken _hata_sayisi = 0;

degisken _p_tok = [];
degisken _p_pos = 0;

fonk p_simdiki() {
    eger _p_pos >= uzunluk(_p_tok) {
        don ["EOF", "EOF", 0, 0];
    }
    don _p_tok[_p_pos];
}

fonk p_tip() { degisken s = p_simdiki(); don s[0]; }
fonk p_deger() { degisken s = p_simdiki(); don s[1]; }
fonk p_satir() { degisken s = p_simdiki(); don s[2]; }

fonk p_ilerle() { _p_pos = _p_pos + 1; }

fonk p_esles(beklenen) {
    eger p_tip() == beklenen {
        degisken d = p_deger();
        p_ilerle();
        don d;
    }
    yaz "[PARSER HATA] Satir " + metine(p_satir()) + " (Pos " + metine(_p_pos) + "): Beklenen '" + beklenen + "' ama '" + p_tip() + ":" + p_deger() + "' geldi";
    _hata_sayisi = _hata_sayisi + 1;
    eger _hata_sayisi >= 5 {
        yaz "--- DEBUG: 5 Hata Alindi, Derleme Durduruldu ---";
        _p_pos = uzunluk(_p_tok);
        don "";
    }
    p_ilerle();
    don "";
}

fonk p_bak_sonraki() {
    degisken sonraki_pos = _p_pos + 1;
    eger sonraki_pos < uzunluk(_p_tok) {
        degisken s = _p_tok[sonraki_pos];
        don s[0];
    }
    don "EOF";
}

fonk p_kontrol(tip) { don p_tip() == tip; }
fonk p_kontrol2(tip, deger) { don p_tip() == tip ve p_deger() == deger; }

fonk parse_birincil() {
    eger p_kontrol("SAYI") {
        degisken v = p_deger(); p_ilerle();
        don ["SAYI", v];
    }
    eger p_kontrol("SAYI_ONDALI") {
        degisken v = p_deger(); p_ilerle();
        don ["SAYI_ONDALI", v];
    }
    eger p_kontrol("STRING") {
        degisken v = p_deger(); p_ilerle();
        don ["STRING", v];
    }
    eger p_kontrol("TUZ") {
        p_ilerle();
        don ["BOOL", "tuz"];
    }
    eger p_kontrol("TERS") {
        p_ilerle();
        don ["BOOL", "ters"];
    }
    eger p_kontrol("BOS") {
        p_ilerle();
        don ["BOS"];
    }
    eger p_kontrol2("OP", "-") {
        p_ilerle();
        degisken sag = parse_birincil();
        don ["TEKLI", "-", sag];
    }
    eger p_kontrol("DEGIL") {
        p_ilerle();
        degisken sag = parse_birincil();
        don ["TEKLI", "degil", sag];
    }
    eger p_kontrol("L_SQ") {
        p_ilerle();
        degisken elemanlar = [];
        iken degil p_kontrol("R_SQ") ve degil p_kontrol("EOF") {
            eger uzunluk(elemanlar) > 0 { p_esles("VIRGUL"); }
            ekle(elemanlar, parse_ifade());
        }
        p_esles("R_SQ");
        don ["LISTE", elemanlar];
    }
    eger p_kontrol("L_P") {
        p_ilerle();
            // Degiskene deger atama: x = ifade;
    eger p_kontrol("ID") {
        degisken isim = p_deger();
        eger p_bak_sonraki() == "ESIT" veya p_kontrol2("ESIT", "=") {
            p_ilerle();
            p_esles("ESIT");
            degisken deger = parse_ifade();
            p_esles("SC");
            don ["ATAMA", isim, deger];
        }
    }

    degisken e = parse_ifade();
        p_esles("R_P");
        don e;
    }
    eger p_kontrol("ID") {
        degisken isim = p_deger();
        p_ilerle();
        eger p_kontrol("L_P") {
            p_ilerle();
            degisken arglar = [];
            iken degil p_kontrol("R_P") ve degil p_kontrol("EOF") {
                eger uzunluk(arglar) > 0 { p_esles("VIRGUL"); }
                ekle(arglar, parse_ifade());
            }
            p_esles("R_P");
            don ["CAGRI", isim, arglar];
        }
        don ["ID", isim];
    }

    yaz "[PARSER HATA] Satir " + metine(p_satir()) + ": Beklenmeyen token '" + p_tip() + ":" + p_deger() + "'";
    p_ilerle();
    don ["HATA", "beklenmeyen_token"];
}

fonk parse_postfix() {
    degisken sol = parse_birincil();
    iken tuz {
        eger p_kontrol("L_SQ") {
            p_ilerle();
            degisken idx = parse_ifade();
            p_esles("R_SQ");
            sol = ["INDEX", sol, idx];
            devam;
        }
        eger p_kontrol("NOKTA") {
            p_ilerle();
            degisken alan = p_esles("ID");
            eger p_kontrol("L_P") {
                p_ilerle();
                degisken arglar = [];
                iken degil p_kontrol("R_P") ve degil p_kontrol("EOF") {
                    eger uzunluk(arglar) > 0 { p_esles("VIRGUL"); }
                    ekle(arglar, parse_ifade());
                }
                p_esles("R_P");
                sol = ["METOT", sol, alan, arglar];
                devam;
            }
            sol = ["ALAN", sol, alan];
            devam;
        }
        kir;
    }
    don sol;
}

fonk parse_carpma() {
    degisken sol = parse_postfix();
    iken p_kontrol("OP") {
        degisken op = p_deger();
        degisken ok = 0;
        eger op == "*" { ok = 1; }
        eger op == "/" { ok = 1; }
        eger op == "%" { ok = 1; }
        eger op == "**" { ok = 1; }
        eger ok == 1 {
            p_ilerle();
            degisken sag = parse_postfix();
            sol = ["BINOP", op, sol, sag];
        } yoksa {
            kir;
        }
    }
    don sol;
}

fonk parse_toplama() {
    degisken sol = parse_carpma();
    iken p_kontrol("OP") {
        degisken op = p_deger();
        degisken ok = 0;
        eger op == "+" { ok = 1; }
        eger op == "-" { ok = 1; }
        eger ok == 1 {
            p_ilerle();
            degisken sag = parse_carpma();
            sol = ["BINOP", op, sol, sag];
        } yoksa {
            kir;
        }
    }
    don sol;
}

fonk parse_karsilastirma() {
    degisken sol = parse_toplama();
    iken p_kontrol("OP") {
        degisken op = p_deger();
        degisken ok = 0;
        eger op == "==" { ok = 1; }
        eger op == "!=" { ok = 1; }
        eger op == "<=" { ok = 1; }
        eger op == ">=" { ok = 1; }
        eger op == "<"  { ok = 1; }
        eger op == ">"  { ok = 1; }
        eger ok == 1 {
            p_ilerle();
            degisken sag = parse_toplama();
            sol = ["BINOP", op, sol, sag];
        } yoksa {
            kir;
        }
    }
    don sol;
}

fonk parse_ve() {
    degisken sol = parse_karsilastirma();
    iken p_kontrol("VE") {
        p_ilerle();
        degisken sag = parse_karsilastirma();
        sol = ["BINOP", "ve", sol, sag];
    }
    don sol;
}

fonk parse_veya() {
    degisken sol = parse_ve();
    iken p_kontrol("VEYA") {
        p_ilerle();
        degisken sag = parse_ve();
        sol = ["BINOP", "veya", sol, sag];
    }
    don sol;
}

fonk parse_ifade() {
    degisken sol = parse_veya();

    eger p_kontrol("ESIT") {
        p_ilerle();
        degisken sag = parse_ifade();
        don ["ATAMA", sol, sag];
    }

    eger p_kontrol("OP") {
        degisken op = p_deger();
        degisken ok = 0;
        eger op == "+=" { ok = 1; }
        eger op == "-=" { ok = 1; }
        eger op == "*=" { ok = 1; }
        eger op == "/=" { ok = 1; }
        eger op == "%=" { ok = 1; }
        eger ok == 1 {
            p_ilerle();
            degisken sag = parse_ifade();
            don ["BILESIK_ATAMA", op, sol, sag];
        }
    }

    don sol;
}

fonk parse_stmt() {
    eger p_kontrol("AKTAR") veya (p_kontrol("ID") ve p_deger() == "aktar") {
        p_ilerle();
        degisken dosya = p_deger();
        p_ilerle();
        p_esles("SC");
        don ["AKTAR", dosya];
    }
    eger p_kontrol("AKTAR") veya (p_kontrol("ID") ve p_deger() == "aktar") {
        p_ilerle();
        degisken dosya = p_deger();
        p_ilerle();
        p_esles("SC");
        don ["AKTAR", dosya];
    }
    eger p_kontrol("DEGISKEN") {
        p_ilerle();
        degisken isim = p_esles("ID");
        p_esles("ESIT");
        degisken deger = parse_ifade();
        p_esles("SC");
        don ["DEGISKEN", isim, deger];
    }

    eger p_kontrol("FONK") {
        p_ilerle();
        degisken isim = p_esles("ID");
        p_esles("L_P");
        degisken params = [];
        iken p_tip() != "EOF" {
            eger p_kontrol("R_P") { kir; }
            eger uzunluk(params) > 0 {
                eger p_kontrol("VIRGUL") veya p_kontrol("CM") {
                    p_ilerle();
                } yoksa {
                    p_esles("VIRGUL");
                }
            }
            eger p_kontrol("ID") {
                ekle(params, p_esles("ID"));
            } yoksa {
                kir;
            }
        }
        p_esles("R_P");
        degisken govde = parse_blok();
        don ["FONK", isim, params, govde];
    }

    eger p_kontrol("EGER") {
        p_ilerle();
        degisken kosul = parse_ifade();
        degisken then_blok = parse_blok();

        eger p_kontrol("YOKSA") {
            p_ilerle();
            eger p_kontrol("EGER") {
                degisken else_dal = parse_stmt();
                don ["EGER", kosul, then_blok, else_dal];
            }
            degisken else_blok = parse_blok();
            don ["EGER", kosul, then_blok, else_blok];
        }

        don ["EGER", kosul, then_blok, ["BLOK", []]];
    }

    eger p_kontrol("IKEN") {
        p_ilerle();
        degisken kosul = parse_ifade();
        degisken govde = parse_blok();
        don ["IKEN", kosul, govde];
    }

    eger p_kontrol("DON") {
        p_ilerle();
        eger p_kontrol("NOKTA_VIRGUL") {
            p_ilerle();
            don ["DON", ["BOS"]];
        }
        degisken e = parse_ifade();
        p_esles("SC");
        don ["DON", e];
    }

    eger p_kontrol("KIR") {
        p_ilerle();
        p_esles("SC");
        don ["KIR"];
    }

    eger p_kontrol("DEVAM") {
        p_ilerle();
        p_esles("SC");
        don ["DEVAM"];
    }

    eger p_kontrol("YAZ") {
        p_ilerle();
        degisken e = parse_ifade();
        p_esles("SC");
        don ["YAZ", e];
    }

    eger p_kontrol("L_B") {
        don parse_blok();
    }

    eger p_kontrol("NOKTA_VIRGUL") {
        p_ilerle();
        don ["BOS_STMT"];
    }

    degisken e = parse_ifade();
    p_esles("SC");
    don ["IFADE", e];
}

fonk parse_blok() {
    p_esles("L_B");
    degisken stmtler = [];
    iken degil p_kontrol("R_B") ve degil p_kontrol("EOF") {
        ekle(stmtler, parse_stmt());
    }
    p_esles("R_B");
    don ["BLOK", stmtler];
}

fonk parse(tokenlar) {
    _p_tok = tokenlar;
    _p_pos = 0;
    _hata_sayisi = 0;
    degisken stmtler = [];
    iken degil p_kontrol("EOF") {
        ekle(stmtler, parse_stmt());
    }
    don ["PROGRAM", stmtler];
}

fonk zedin_parse(kaynak_kodu) {
    degisken tokenlar = tara(kaynak_kodu);
    don parse(tokenlar);
}
