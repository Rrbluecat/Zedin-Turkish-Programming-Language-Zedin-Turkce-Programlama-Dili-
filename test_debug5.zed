aktar "interpreter.zed";
aktar "compiler.zed";

degisken kod = "fonk selam(isim) { don isim; } yaz selam(\"Zedin\");";
degisken tok = tara(kod);
degisken ast = parse(tok);
degisken ch = chunk_yeni("<ana>");
_global_mod = tuz;
derle_stmt(ch, ast[0]);
yaz "Sonra degiskenler: " + metine(ch[2]);
yaz "selam bul: " + metine(chunk_degisken_bul(ch, "selam"));
