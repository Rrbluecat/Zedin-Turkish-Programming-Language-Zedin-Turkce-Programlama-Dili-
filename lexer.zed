         k == "R" veya k == "S" veya k == "T" veya k == "U" veya
         k == "V" veya k == "X" veya k == "Y" veya k == "Z" veya k == "_" veya
         k == "ğ" veya k == "ü" veya k == "ş" veya k == "ı" veya k == "ö" veya k == "ç" veya
