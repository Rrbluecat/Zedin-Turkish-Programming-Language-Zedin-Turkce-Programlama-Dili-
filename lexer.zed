// ============================================================
// lexer.zed - Zedin Self-hosting Lexer
// ============================================================

degisken _lex_satir = 1;
degisken _lex_kolon = 1;
degisken _lexer_tokenlar = [];

fonk tok_ekle_lex(tip, deger, satir, kolon) {
    ekle(_lexer_tokenlar, [tip, deger, satir, kolon]);
}

fonk harf_mi(c) {
    degisken h = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_ÇçĞğİıÖöŞşÜü";
    degisken i = 0;
    iken i < uzunluk(h) {
        eger c == h[i] { don 1; }
        i = i + 1;
    }
    don 0;
}

fonk rakam_mi(c) {
    degisken r = "0123456789";
    degisken i = 0;
    iken i < uzunluk(r) {
        eger c == r[i] { don 1; }
        i = i + 1;
    }
    don 0;
}

fonk tara(kaynak) {
    _lexer_tokenlar = [];
    _lex_satir = 1;
    _lex_kolon = 1;

    degisken boy = uzunluk(kaynak);
    degisken i = 0;

    iken i < boy {
        degisken k = kaynak[i];

        // Yeni satir
        eger k == "\n" {
            _lex_satir = _lex_satir + 1;
            _lex_kolon = 1;
            i = i + 1;
            devam;
        }

        // Bosluklar
        eger k == " " veya k == "\t" veya char_kodu(k) == 13 {
            _lex_kolon = _lex_kolon + 1;
            i = i + 1;
            devam;
        }

        // Yorumlar: // ...
        eger k == "/" ve i + 1 < boy ve kaynak[i + 1] == "/" {
            iken i < boy ve kaynak[i] != "\n" {
                i = i + 1;
            }
            devam;
        }

        // Rakam / Sayi
        eger rakam_mi(k) {
            degisken bas_kolon = _lex_kolon;
            degisken s = "";
            degisken ondali = 0;
            iken i < boy ve (rakam_mi(kaynak[i]) veya kaynak[i] == ".") {
                eger kaynak[i] == "." { ondali = 1; }
                s = s + kaynak[i];
                i = i + 1;
                _lex_kolon = _lex_kolon + 1;
            }
            eger ondali == 1 {
                tok_ekle_lex("SAYI_ONDALI", s, _lex_satir, bas_kolon);
            } yoksa {
                tok_ekle_lex("SAYI", s, _lex_satir, bas_kolon);
            }
            devam;
        }

        // Tanimlayici veya Anahtar Kelime
        eger harf_mi(k) {
            degisken bas_kolon = _lex_kolon;
            degisken kelime = "";
            iken i < boy ve (harf_mi(kaynak[i]) veya rakam_mi(kaynak[i])) {
                kelime = kelime + kaynak[i];
                i = i + 1;
                _lex_kolon = _lex_kolon + 1;
            }

            eger kelime == "degisken" { tok_ekle_lex("DEGISKEN", kelime, _lex_satir, bas_kolon); devam; }
            eger kelime == "fonk"     { tok_ekle_lex("FONK", kelime, _lex_satir, bas_kolon); devam; }
            eger kelime == "eger"     { tok_ekle_lex("EGER", kelime, _lex_satir, bas_kolon); devam; }
            eger kelime == "yoksa"    { tok_ekle_lex("YOKSA", kelime, _lex_satir, bas_kolon); devam; }
            eger kelime == "iken"     { tok_ekle_lex("IKEN", kelime, _lex_satir, bas_kolon); devam; }
            eger kelime == "don"      { tok_ekle_lex("DON", kelime, _lex_satir, bas_kolon); devam; }
            eger kelime == "kir"      { tok_ekle_lex("KIR", kelime, _lex_satir, bas_kolon); devam; }
            eger kelime == "devam"    { tok_ekle_lex("DEVAM", kelime, _lex_satir, bas_kolon); devam; }
            eger kelime == "yaz"      { tok_ekle_lex("YAZ", kelime, _lex_satir, bas_kolon); devam; }
            eger kelime == "ve"       { tok_ekle_lex("VE", kelime, _lex_satir, bas_kolon); devam; }
            eger kelime == "veya"     { tok_ekle_lex("VEYA", kelime, _lex_satir, bas_kolon); devam; }
            eger kelime == "degil"    { tok_ekle_lex("DEGIL", kelime, _lex_satir, bas_kolon); devam; }
            eger kelime == "tuz"      { tok_ekle_lex("TUZ", kelime, _lex_satir, bas_kolon); devam; }
            eger kelime == "ters"     { tok_ekle_lex("TERS", kelime, _lex_satir, bas_kolon); devam; }
            eger kelime == "bos"      { tok_ekle_lex("BOS", kelime, _lex_satir, bas_kolon); devam; }

            tok_ekle_lex("ID", kelime, _lex_satir, bas_kolon);
            devam;
        }

        // String Literali "..."
        degisken TIRNAK = karakter_yap(34);
        eger k == TIRNAK {
            degisken bas_kolon = _lex_kolon;
            i = i + 1;
            _lex_kolon = _lex_kolon + 1;
            degisken str_val = "";
            iken i < boy ve kaynak[i] != TIRNAK {
                str_val = str_val + kaynak[i];
                i = i + 1;
                _lex_kolon = _lex_kolon + 1;
            }
            i = i + 1;
            _lex_kolon = _lex_kolon + 1;
            tok_ekle_lex("STRING", str_val, _lex_satir, bas_kolon);
            devam;
        }

        // Operatörler
        degisken tok_satir = _lex_satir;
        degisken tok_kolon = _lex_kolon;

        eger k == "=" {
            eger i + 1 < boy ve kaynak[i + 1] == "=" {
                tok_ekle_lex("OP", "==", tok_satir, tok_kolon);
                i = i + 2; _lex_kolon = _lex_kolon + 2; devam;
            } yoksa {
                tok_ekle_lex("ESIT", "=", tok_satir, tok_kolon);
                i = i + 1; _lex_kolon = _lex_kolon + 1; devam;
            }
        }

        eger k == "!" {
            eger i + 1 < boy ve kaynak[i + 1] == "=" {
                tok_ekle_lex("OP", "!=", tok_satir, tok_kolon);
                i = i + 2; _lex_kolon = _lex_kolon + 2; devam;
            }
        }

        eger k == "<" {
            eger i + 1 < boy ve kaynak[i + 1] == "=" {
                tok_ekle_lex("OP", "<=", tok_satir, tok_kolon);
                i = i + 2; _lex_kolon = _lex_kolon + 2; devam;
            } yoksa {
                tok_ekle_lex("OP", "<", tok_satir, tok_kolon);
                i = i + 1; _lex_kolon = _lex_kolon + 1; devam;
            }
        }

        eger k == ">" {
            eger i + 1 < boy ve kaynak[i + 1] == "=" {
                tok_ekle_lex("OP", ">=", tok_satir, tok_kolon);
                i = i + 2; _lex_kolon = _lex_kolon + 2; devam;
            } yoksa {
                tok_ekle_lex("OP", ">", tok_satir, tok_kolon);
                i = i + 1; _lex_kolon = _lex_kolon + 1; devam;
            }
        }

        eger k == "+" {
            eger i + 1 < boy ve kaynak[i + 1] == "=" {
                tok_ekle_lex("OP", "+=", tok_satir, tok_kolon);
                i = i + 2; _lex_kolon = _lex_kolon + 2; devam;
            } yoksa {
                tok_ekle_lex("OP", "+", tok_satir, tok_kolon);
                i = i + 1; _lex_kolon = _lex_kolon + 1; devam;
            }
        }

        eger k == "-" {
            eger i + 1 < boy ve kaynak[i + 1] == "=" {
                tok_ekle_lex("OP", "-=", tok_satir, tok_kolon);
                i = i + 2; _lex_kolon = _lex_kolon + 2; devam;
            } yoksa {
                tok_ekle_lex("OP", "-", tok_satir, tok_kolon);
                i = i + 1; _lex_kolon = _lex_kolon + 1; devam;
            }
        }

        eger k == "%" {
            tok_ekle_lex("OP", "%", tok_satir, tok_kolon);
            i = i + 1; _lex_kolon = _lex_kolon + 1; devam;
        }

        eger k == "*" {
            eger i + 1 < boy ve kaynak[i + 1] == "=" {
                tok_ekle_lex("OP", "*=", tok_satir, tok_kolon);
                i = i + 2; _lex_kolon = _lex_kolon + 2; devam;
            } yoksa {
                tok_ekle_lex("OP", "*", tok_satir, tok_kolon);
                i = i + 1; _lex_kolon = _lex_kolon + 1; devam;
            }
        }

        eger k == "/" {
            eger i + 1 < boy ve kaynak[i + 1] == "=" {
                tok_ekle_lex("OP", "/=", tok_satir, tok_kolon);
                i = i + 2; _lex_kolon = _lex_kolon + 2; devam;
            } yoksa {
                tok_ekle_lex("OP", "/", tok_satir, tok_kolon);
                i = i + 1; _lex_kolon = _lex_kolon + 1; devam;
            }
        }

        // Noktalama ve Tek Karakterler
        eger k == ";" { tok_ekle_lex("NOKTA_VIRGUL", ";", tok_satir, tok_kolon); i = i + 1; _lex_kolon = _lex_kolon + 1; devam; }
        eger k == "," { tok_ekle_lex("VIRGUL", ",", tok_satir, tok_kolon); i = i + 1; _lex_kolon = _lex_kolon + 1; devam; }
        eger k == "." { tok_ekle_lex("NOKTA", ".", tok_satir, tok_kolon); i = i + 1; _lex_kolon = _lex_kolon + 1; devam; }
        eger k == "(" { tok_ekle_lex("L_P", "(", tok_satir, tok_kolon); i = i + 1; _lex_kolon = _lex_kolon + 1; devam; }
        eger k == ")" { tok_ekle_lex("R_P", ")", tok_satir, tok_kolon); i = i + 1; _lex_kolon = _lex_kolon + 1; devam; }
        eger k == "{" { tok_ekle_lex("L_B", "{", tok_satir, tok_kolon); i = i + 1; _lex_kolon = _lex_kolon + 1; devam; }
        eger k == "}" { tok_ekle_lex("R_B", "}", tok_satir, tok_kolon); i = i + 1; _lex_kolon = _lex_kolon + 1; devam; }
        eger k == "[" { tok_ekle_lex("L_SQ", "[", tok_satir, tok_kolon); i = i + 1; _lex_kolon = _lex_kolon + 1; devam; }
        eger k == "]" { tok_ekle_lex("R_SQ", "]", tok_satir, tok_kolon); i = i + 1; _lex_kolon = _lex_kolon + 1; devam; }

        i = i + 1;
        _lex_kolon = _lex_kolon + 1;
    }

    tok_ekle_lex("EOF", "", _lex_satir, _lex_kolon);
    don _lexer_tokenlar;
}