aktar "interpreter.zed";
degisken kod = "fonk topla(a, b) { don a + b; } yaz topla(1, 2, 3);";
degisken tokenlar = tara(kod);
degisken ast = parse(tokenlar);
yaz "YAZ stmt:";
yaz metine(ast[1]);
yaz "YAZ[0]: " + ast[1][0];
yaz "YAZ[1][0]: " + ast[1][1][0];
yaz "YAZ[1][1]: " + ast[1][1][1];
yaz "YAZ[1][2] uzunluk: " + metine(uzunluk(ast[1][1][2]));
