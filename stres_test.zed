yaz("--- 1. Döngü Testi (İç İçe, Kır ve Devam) ---");
degisken i = 0;
iken (i < 3) {
    degisken j = 0;
    iken (j < 5) {
        j = j + 1;
        eger (j == 2) { devam; } // 2'yi atla
        eger (j == 4) { kır; }   // 4'te iç döngüyü kır
        yaz(i * 10 + j);
    }
    i = i + 1;
}

yaz("--- 2. Metin Testi (Birleştirme ve Karşılaştırma) ---");
degisken selam = "Merhaba ";
degisken dunya = "Zedin";
degisken mesaj = selam + dunya;
yaz(mesaj);

eger (mesaj == "Merhaba Zedin") {
    yaz("Eşitlik Yakalandı: Tamam!");
} yoksa {
    yaz("Hata: Metinler Eşleşmedi!");
}
