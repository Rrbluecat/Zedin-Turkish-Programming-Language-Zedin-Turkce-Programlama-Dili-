aktar "matematik.zed";

fonk ana() {
    yaz "=== Zedin Matematik Modulu Testi ===";
    
    yaz "5 Faktoriyel (Beklenen: 120):";
    yaz fakt(5);
    
    yaz "EBOB(48, 18) (Beklenen: 6):";
    yaz ebob(48, 18);
    
    yaz "EKOK(12, 15) (Beklenen: 60):";
    yaz ekok(12, 15);
    
    yaz "7 Asal mi? (Beklenen: 1):";
    yaz asal_mi(7);
    
    yaz "Fibonacci(8) (Beklenen: 21):";
    yaz fib(8);

    yaz "Sigma(1, 10) (Beklenen: 55):";
    yaz sigma(1, 10);

    don 0;
}
