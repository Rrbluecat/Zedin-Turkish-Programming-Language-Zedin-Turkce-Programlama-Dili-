// ============================================================
// asm_backend.zed - Zedin AST -> ARM64 Assembly
// ============================================================

degisken _asm_satirlar = [];
degisken _veri_satirlar = [];
degisken _degisken_satirlar = [];
degisken _str_sayac = 0;
degisken _degiskenler = [];
degisken _stack_boyut = 0;
degisken _etiket_sayac = 0;
degisken _yerel_mod = ters;
degisken _yerel_degiskenler = [];
degisken _yerel_offset = 0;
degisken _fonk_satirlar = [];
degisken _dongu_etiketler = [];

fonk asm_yaz(satir) {
    ekle(_asm_satirlar, satir);
}

fonk veri_yaz(satir) {
    ekle(_veri_satirlar, satir);
}

fonk yeni_str_etiketi() {
    _str_sayac = _str_sayac + 1;
    don "_str_" + metine(_str_sayac);
}

fonk yeni_etiket() {
    _etiket_sayac = _etiket_sayac + 1;
    don "_L" + metine(_etiket_sayac);
}

// Karsilastirma operatoru -> ARM64 dal komutu (ters kosul)
fonk ifade_metin_mi(ifade) {
    eger ifade == bos { don ters; }
    eger ifade[0] == "STR" { don tuz; }
    eger ifade[0] == "ID" {
        degisken t = degisken_tip_bul_tam(ifade[1]);
        eger t == "metin" { don tuz; }
    }
    eger ifade[0] == "CAGRI" ve uzunluk(ifade) > 1 ve (ifade[1] == "metine" veya ifade[1] == "oku_dosya") { don tuz; }
    eger ifade[0] == "INDEX" ve uzunluk(ifade) > 1 {
        degisken itaban = ifade[1];
        eger itaban[0] == "ID" ve degisken_tip_bul_tam(itaban[1]) == "metin" { don tuz; }
        eger itaban[0] == "STR" { don tuz; }
    }
    eger ifade[0] == "BINOP" ve ifade[1] == "+" ve uzunluk(ifade) > 3 {
        eger ifade_metin_mi(ifade[2]) veya ifade_metin_mi(ifade[3]) { don tuz; }
    }
    don ters;
}

fonk ters_dal(op) {
    eger op == "==" { don "b.ne"; }
    eger op == "!=" { don "b.eq"; }
    eger op == "<"  { don "b.ge"; }
    eger op == ">"  { don "b.le"; }
    eger op == "<=" { don "b.gt"; }
    eger op == ">=" { don "b.lt"; }
    don "b.ne";
}

fonk asm_baslik() {
    _degiskenler = [];
    _stack_boyut = 0;
    asm_yaz(".section .text");
    asm_yaz(".global main");
    asm_yaz("main:");
    asm_yaz("    stp x29, x30, [sp, #-16]!");
    asm_yaz("    mov x29, sp");
}

fonk asm_son() {
    asm_yaz("    mov x0, #0");
    asm_yaz("    ldp x29, x30, [sp], #16");
    asm_yaz("    ret");
    // Fonksiyon tanimlarini main'den sonra ekle
    degisken fi = 0;
    iken fi < uzunluk(_fonk_satirlar) {
        asm_yaz(_fonk_satirlar[fi]);
        fi = fi + 1;
    }
    // Zedin runtime yardimcilari (string islemleri)
    asm_yaz("");
    asm_yaz("_zedin_strlen:");
    asm_yaz("    mov x1, x0");
    asm_yaz("    mov x2, #0");
    asm_yaz("_zedin_strlen_dongu:");
    asm_yaz("    ldrb w3, [x1], #1");
    asm_yaz("    cbz w3, _zedin_strlen_bitis");
    asm_yaz("    add x2, x2, #1");
    asm_yaz("    b _zedin_strlen_dongu");
    asm_yaz("_zedin_strlen_bitis:");
    asm_yaz("    mov x0, x2");
    asm_yaz("    ret");
    asm_yaz("");
    asm_yaz("_zedin_metine:");
    asm_yaz("    mov x1, x0");
    asm_yaz("    adr x2, _metine_buf");
    asm_yaz("    add x2, x2, #31");
    asm_yaz("    mov x3, #0");
    asm_yaz("    strb w3, [x2]");
    asm_yaz("    mov x4, #10");
    asm_yaz("_zedin_metine_dongu:");
    asm_yaz("    sub x2, x2, #1");
    asm_yaz("    udiv x3, x1, x4");
    asm_yaz("    msub x5, x3, x4, x1");
    asm_yaz("    add x5, x5, #48");
    asm_yaz("    strb w5, [x2]");
    asm_yaz("    mov x1, x3");
    asm_yaz("    cbnz x1, _zedin_metine_dongu");
    asm_yaz("    mov x0, x2");
    asm_yaz("    ret");
    asm_yaz("");
    asm_yaz("_zedin_sayiya:");
    asm_yaz("    mov x1, x0");
    asm_yaz("    mov x2, #0");
    asm_yaz("    mov x4, #10");
    asm_yaz("_zedin_sayiya_dongu:");
    asm_yaz("    ldrb w3, [x1], #1");
    asm_yaz("    sub w3, w3, #48");
    asm_yaz("    cmp w3, #9");
    asm_yaz("    b.hi _zedin_sayiya_bitis");
    asm_yaz("    madd x2, x2, x4, x3");
    asm_yaz("    b _zedin_sayiya_dongu");
    asm_yaz("_zedin_sayiya_bitis:");
    asm_yaz("    mov x0, x2");
    asm_yaz("    ret");
    asm_yaz("");
    asm_yaz("_zedin_str_chr:");
    asm_yaz("    adr x2, _char_buf");
    asm_yaz("    ldrb w3, [x0, x1]");
    asm_yaz("    strb w3, [x2]");
    asm_yaz("    mov w3, #0");
    asm_yaz("    strb w3, [x2, #1]");
    asm_yaz("    mov x0, x2");
    asm_yaz("    ret");
    asm_yaz("");
    asm_yaz("_zedin_char_kodu:");
    asm_yaz("    ldrb w0, [x0]");
    asm_yaz("    ret");
    asm_yaz("");
    asm_yaz("_zedin_liste_yeni:");
    asm_yaz("    stp x29, x30, [sp, #-16]!");
    asm_yaz("    mov x29, sp");
    asm_yaz("    stp x19, x20, [sp, #-16]!");
    asm_yaz("    mov x19, x0");
    asm_yaz("    mov x0, #24");
    asm_yaz("    bl malloc");
    asm_yaz("    mov x20, x0");
    asm_yaz("    lsl x0, x19, #3");
    asm_yaz("    bl malloc");
    asm_yaz("    str x0, [x20, #16]");
    asm_yaz("    str x19, [x20]");
    asm_yaz("    str x19, [x20, #8]");
    asm_yaz("    mov x0, x20");
    asm_yaz("    ldp x19, x20, [sp], #16");
    asm_yaz("    ldp x29, x30, [sp], #16");
    asm_yaz("    ret");
    asm_yaz("");
    asm_yaz("_zedin_ekle:");
    asm_yaz("    stp x29, x30, [sp, #-16]!");
    asm_yaz("    mov x29, sp");
    asm_yaz("    stp x19, x20, [sp, #-16]!");
    asm_yaz("    stp x21, x22, [sp, #-16]!");
    asm_yaz("    mov x19, x0");
    asm_yaz("    mov x20, x1");
    asm_yaz("    ldr x21, [x19]");
    asm_yaz("    ldr x22, [x19, #8]");
    asm_yaz("    cmp x22, x21");
    asm_yaz("    b.lt _zedin_ekle_yaz");
    asm_yaz("    cbnz x21, _zedin_ekle_buyut");
    asm_yaz("    mov x21, #4");
    asm_yaz("    b _zedin_ekle_realloc");
    asm_yaz("_zedin_ekle_buyut:");
    asm_yaz("    lsl x21, x21, #1");
    asm_yaz("_zedin_ekle_realloc:");
    asm_yaz("    str x21, [x19]");
    asm_yaz("    ldr x0, [x19, #16]");
    asm_yaz("    lsl x1, x21, #3");
    asm_yaz("    bl realloc");
    asm_yaz("    str x0, [x19, #16]");
    asm_yaz("_zedin_ekle_yaz:");
    asm_yaz("    ldr x0, [x19, #16]");
    asm_yaz("    ldr x1, [x19, #8]");
    asm_yaz("    str x20, [x0, x1, lsl #3]");
    asm_yaz("    add x1, x1, #1");
    asm_yaz("    str x1, [x19, #8]");
    asm_yaz("    mov x0, x19");
    asm_yaz("    ldp x21, x22, [sp], #16");
    asm_yaz("    ldp x19, x20, [sp], #16");
    asm_yaz("    ldp x29, x30, [sp], #16");
    asm_yaz("    ret");
    asm_yaz("");
    asm_yaz("_zedin_cikar:");
    asm_yaz("    stp x29, x30, [sp, #-16]!");
    asm_yaz("    mov x29, sp");
    asm_yaz("    stp x19, x20, [sp, #-16]!");
    asm_yaz("    stp x21, x22, [sp, #-16]!");
    asm_yaz("    mov x19, x0");
    asm_yaz("    mov x20, x1");
    asm_yaz("    ldr x21, [x19, #8]");
    asm_yaz("    cmp x20, x21");
    asm_yaz("    b.ge _zedin_cikar_bitis");
    asm_yaz("    ldr x22, [x19, #16]");
    asm_yaz("    sub x21, x21, #1");
    asm_yaz("_zedin_cikar_dongu:");
    asm_yaz("    add x0, x20, #1");
    asm_yaz("    cmp x0, x21");
    asm_yaz("    b.ge _zedin_cikar_son");
    asm_yaz("    ldr x0, [x22, x0, lsl #3]");
    asm_yaz("    str x0, [x22, x20, lsl #3]");
    asm_yaz("    add x20, x20, #1");
    asm_yaz("    b _zedin_cikar_dongu");
    asm_yaz("_zedin_cikar_son:");
    asm_yaz("    str x21, [x19, #8]");
    asm_yaz("_zedin_cikar_bitis:");
    asm_yaz("    ldp x21, x22, [sp], #16");
    asm_yaz("    ldp x19, x20, [sp], #16");
    asm_yaz("    ldp x29, x30, [sp], #16");
    asm_yaz("    ret");
    veri_yaz(".section .data");
    // Once degiskenler
    degisken di = 0;
    iken di < uzunluk(_degisken_satirlar) {
        veri_yaz(_degisken_satirlar[di]);
        di = di + 1;
    }
    veri_yaz("_fmt_sayi: .byte 37, 100, 10, 0");
    veri_yaz("_fmt_str_sayi: .byte 37, 115, 37, 100, 10, 0");
    veri_yaz("_fmt_str_str: .byte 37, 115, 37, 115, 10, 0");
    veri_yaz("_buf: .space 256");
    veri_yaz("_metine_buf: .space 32");
    veri_yaz("_char_buf: .space 16");
}

fonk asm_str_tanimla(etiket, deger) {
    ekle(_degisken_satirlar, etiket + ": .asciz \"" + deger + "\"");
}

fonk asm_puts(etiket) {
    asm_yaz("    adr x0, " + etiket);
    asm_yaz("    bl puts");
}

// Degisken bul: etiket adi don
fonk degisken_bul(isim) {
    eger _yerel_mod {
        degisken yi = uzunluk(_yerel_degiskenler) - 1;
        iken yi >= 0 {
            eger _yerel_degiskenler[yi][0] == isim {
                don "__yerel_" + metine(_yerel_degiskenler[yi][1]) + "__";
            }
            yi = yi - 1;
        }
    }
    degisken i = 0;
    iken i < uzunluk(_degiskenler) {
        eger _degiskenler[i][0] == isim {
            don _degiskenler[i][1];
        }
        i = i + 1;
    }
    don "";
}

fonk degisken_tip_bul_tam(isim) {
    eger _yerel_mod {
        degisken yt = yerel_tip_bul(isim);
        eger yt != "sayi" veya yerel_bul(isim) >= 0 { don yt; }
    }
    don degisken_tip_bul(isim);
}

// Degisken tipini bul
fonk degisken_tip_bul(isim) {
    degisken i = 0;
    iken i < uzunluk(_degiskenler) {
        eger _degiskenler[i][0] == isim { don _degiskenler[i][2]; }
        i = i + 1;
    }
    don "sayi";
}

// Degisken ekle, .data etiketi don
fonk degisken_ekle_tipli(isim, veri_tipi) {
    eger _yerel_mod {
        _yerel_offset = _yerel_offset + 8;
        ekle(_yerel_degiskenler, [isim, _yerel_offset, veri_tipi]);
        don "__yerel__";
    }
    degisken etiket = "_var_" + isim;
    ekle(_degiskenler, [isim, etiket, veri_tipi]);
    ekle(_degisken_satirlar, etiket + ": .quad 0");
    don etiket;
}

fonk degisken_ekle(isim) {
    don degisken_ekle_tipli(isim, "sayi");
}

fonk yerel_bul(isim) {
    degisken i = uzunluk(_yerel_degiskenler) - 1;
    iken i >= 0 {
        eger _yerel_degiskenler[i][0] == isim { don _yerel_degiskenler[i][1]; }
        i = i - 1;
    }
    don -1;
}

fonk yerel_tip_bul(isim) {
    degisken i = uzunluk(_yerel_degiskenler) - 1;
    iken i >= 0 {
        eger _yerel_degiskenler[i][0] == isim { don _yerel_degiskenler[i][2]; }
        i = i - 1;
    }
    don "sayi";
}

// Ifadeyi x0 registerina yukle
fonk kodla_ifade(ifade) {
    eger ifade == bos { asm_yaz("    mov x0, #0"); don 0; }
    degisken dt = ifade[0];

    eger dt == "SAYI" {
        degisken sayi_val = sayiya(ifade[1]);
        eger sayi_val >= 0 ve sayi_val <= 65535 {
            asm_yaz("    mov x0, #" + ifade[1]);
        } yoksa {
            degisken lo = metine(bit_ve(sayi_val, 65535));
            degisken hi = metine(bit_ve(bit_kaydir_sag(sayi_val, 16), 65535));
            asm_yaz("    movz x0, #" + lo);
            asm_yaz("    movk x0, #" + hi + ", lsl #16");
        }
        don 0;
    }
    eger dt == "STR" {
        degisken etiket = yeni_str_etiketi();
        asm_str_tanimla(etiket, ifade[1]);
        asm_yaz("    adr x0, " + etiket);
        don 0;
    }
    eger dt == "BOOL" {
        eger ifade[1] == "1" {
            asm_yaz("    mov x0, #1");
        } yoksa {
            asm_yaz("    mov x0, #0");
        }
        don 0;
    }
    eger dt == "ID" {
        degisken etiket = degisken_bul(ifade[1]);
        eger uzunluk(etiket) > 0 {
            eger etiket[0] == "_" ve uzunluk(etiket) > 8 ve etiket[1] == "_" {
                degisken off_str = "";
                degisken oi = 8;
                iken oi < uzunluk(etiket) ve etiket[oi] != "_" {
                    off_str = off_str + etiket[oi];
                    oi = oi + 1;
                }
                asm_yaz("    ldr x0, [x29, #-" + off_str + "]");
            } yoksa {
                asm_yaz("    adr x1, " + etiket);
                asm_yaz("    ldr x0, [x1]");
            }
        }
        don 0;
    }

    eger dt == "CAGRI" {
        degisken fn_isim = ifade[1];
        degisken fn_arglar = ifade[2];

        eger fn_isim == "uzunluk" ve uzunluk(fn_arglar) == 1 {
            degisken hedef_ifade = fn_arglar[0];
            eger hedef_ifade[0] == "ID" ve degisken_tip_bul_tam(hedef_ifade[1]) == "metin" {
                kodla_ifade(hedef_ifade);
                asm_yaz("    bl _zedin_strlen");
                don 0;
            }
            eger hedef_ifade[0] == "STR" {
                degisken uzun_st_etiket = yeni_str_etiketi();
                asm_str_tanimla(uzun_st_etiket, hedef_ifade[1]);
                asm_yaz("    adr x0, " + uzun_st_etiket);
                asm_yaz("    bl _zedin_strlen");
                don 0;
            }
            // Liste (heap struct): uzunluk = [x0 + 8]
            kodla_ifade(hedef_ifade);
            asm_yaz("    ldr x0, [x0, #8]");
            don 0;
        }

        eger fn_isim == "ekle" ve uzunluk(fn_arglar) == 2 {
            kodla_ifade(fn_arglar[0]);
            asm_yaz("    str x0, [sp, #-16]!");
            kodla_ifade(fn_arglar[1]);
            asm_yaz("    mov x1, x0");
            asm_yaz("    ldr x0, [sp]");
            asm_yaz("    add sp, sp, #16");
            asm_yaz("    bl _zedin_ekle");
            don 0;
        }

        eger fn_isim == "cikar" ve uzunluk(fn_arglar) == 2 {
            kodla_ifade(fn_arglar[0]);
            asm_yaz("    str x0, [sp, #-16]!");
            kodla_ifade(fn_arglar[1]);
            asm_yaz("    mov x1, x0");
            asm_yaz("    ldr x0, [sp]");
            asm_yaz("    add sp, sp, #16");
            asm_yaz("    bl _zedin_cikar");
            don 0;
        }

        eger fn_isim == "metine" ve uzunluk(fn_arglar) == 1 {
            kodla_ifade(fn_arglar[0]);
            asm_yaz("    bl _zedin_metine");
            don 0;
        }

        eger fn_isim == "sayiya" ve uzunluk(fn_arglar) == 1 {
            degisken sarg = fn_arglar[0];
            eger sarg[0] == "STR" {
                kodla_ifade(sarg);
                asm_yaz("    bl _zedin_sayiya");
                don 0;
            }
            eger sarg[0] == "ID" ve degisken_tip_bul_tam(sarg[1]) == "metin" {
                kodla_ifade(sarg);
                asm_yaz("    bl _zedin_sayiya");
                don 0;
            }
            kodla_ifade(sarg);
            don 0;
        }

        eger fn_isim == "char_kodu" ve uzunluk(fn_arglar) == 1 {
            kodla_ifade(fn_arglar[0]);
            asm_yaz("    bl _zedin_char_kodu");
            don 0;
        }

        eger fn_isim == "oku_dosya" ve uzunluk(fn_arglar) == 1 {
            // Dosyayi tamamen oku, buffer adresini x0'da dondur (basarisizsa x0=0)
            degisken mod_etiket = yeni_str_etiketi();
            asm_str_tanimla(mod_etiket, "r");
            kodla_ifade(fn_arglar[0]);
            asm_yaz("    mov x19, x0");
            asm_yaz("    adr x1, " + mod_etiket);
            asm_yaz("    bl fopen");
            asm_yaz("    mov x20, x0");
            degisken hata_et = yeni_etiket();
            degisken bitis_et = yeni_etiket();
            asm_yaz("    cmp x20, #0");
            asm_yaz("    b.eq " + hata_et);
            // fseek(f, 0, SEEK_END=2)
            asm_yaz("    mov x0, x20");
            asm_yaz("    mov x1, #0");
            asm_yaz("    mov x2, #2");
            asm_yaz("    bl fseek");
            // ftell(f) -> boyut
            asm_yaz("    mov x0, x20");
            asm_yaz("    bl ftell");
            asm_yaz("    mov x21, x0");
            // fseek(f, 0, SEEK_SET=0)
            asm_yaz("    mov x0, x20");
            asm_yaz("    mov x1, #0");
            asm_yaz("    mov x2, #0");
            asm_yaz("    bl fseek");
            // malloc(boyut + 1)
            asm_yaz("    mov x0, x21");
            asm_yaz("    add x0, x0, #1");
            asm_yaz("    bl malloc");
            asm_yaz("    mov x22, x0");
            // fread(buf, 1, boyut, f)
            asm_yaz("    mov x1, #1");
            asm_yaz("    mov x2, x21");
            asm_yaz("    mov x3, x20");
            asm_yaz("    bl fread");
            // null-terminator: buf[boyut] = 0
            asm_yaz("    mov x0, x22");
            asm_yaz("    add x0, x0, x21");
            asm_yaz("    mov w1, #0");
            asm_yaz("    strb w1, [x0]");
            // fclose(f)
            asm_yaz("    mov x0, x20");
            asm_yaz("    bl fclose");
            asm_yaz("    mov x0, x22");
            asm_yaz("    b " + bitis_et);
            asm_yaz(hata_et + ":");
            asm_yaz("    mov x0, #0");
            asm_yaz(bitis_et + ":");
            don 0;
        }

        eger fn_isim == "byte_dosya_temizle" ve uzunluk(fn_arglar) == 1 {
            degisken mod_etiket2 = yeni_str_etiketi();
            asm_str_tanimla(mod_etiket2, "w");
            kodla_ifade(fn_arglar[0]);
            asm_yaz("    mov x19, x0");
            asm_yaz("    mov x0, x19");
            asm_yaz("    adr x1, " + mod_etiket2);
            asm_yaz("    bl fopen");
            asm_yaz("    cmp x0, #0");
            degisken skip_et = yeni_etiket();
            asm_yaz("    b.eq " + skip_et);
            asm_yaz("    bl fclose");
            asm_yaz(skip_et + ":");
            don 0;
        }

        eger fn_isim == "byte_yaz" ve uzunluk(fn_arglar) == 2 {
            degisken mod_etiket3 = yeni_str_etiketi();
            asm_str_tanimla(mod_etiket3, "ab");
            kodla_ifade(fn_arglar[0]);
            asm_yaz("    mov x19, x0");
            kodla_ifade(fn_arglar[1]);
            asm_yaz("    mov x20, x0");
            asm_yaz("    mov x0, x19");
            asm_yaz("    adr x1, " + mod_etiket3);
            asm_yaz("    bl fopen");
            asm_yaz("    cmp x0, #0");
            degisken skip_et2 = yeni_etiket();
            asm_yaz("    b.eq " + skip_et2);
            asm_yaz("    mov x21, x0");
            asm_yaz("    mov x0, x20");
            asm_yaz("    mov x1, x21");
            asm_yaz("    bl fputc");
            asm_yaz("    mov x0, x21");
            asm_yaz("    bl fclose");
            asm_yaz(skip_et2 + ":");
            don 0;
        }

        // Argumanlari once x19,x20,x21'e hesapla (callee-saved), sonra x0,x1,x2'ye koy
        degisken ai = 0;
        iken ai < uzunluk(fn_arglar) {
            kodla_ifade(fn_arglar[ai]);
            asm_yaz("    mov x" + metine(ai + 19) + ", x0");
            ai = ai + 1;
        }
        ai = 0;
        iken ai < uzunluk(fn_arglar) {
            asm_yaz("    mov x" + metine(ai) + ", x" + metine(ai + 19));
            ai = ai + 1;
        }
        // x22/x23 kaydet, fonksiyon bozabilir
        asm_yaz("    stp x22, x23, [sp, #-16]!");
        asm_yaz("    bl " + fn_isim);
        asm_yaz("    ldp x22, x23, [sp], #16");
        don 0;
    }

    eger dt == "LISTE" {
        degisken elemanlar = ifade[1];
        asm_yaz("    mov x0, #" + metine(uzunluk(elemanlar)));
        asm_yaz("    bl _zedin_liste_yeni");
        asm_yaz("    stp x0, x1, [sp, #-16]!");
        degisken li = 0;
        iken li < uzunluk(elemanlar) {
            kodla_ifade(elemanlar[li]);
            asm_yaz("    ldr x1, [sp]");
            asm_yaz("    ldr x1, [x1, #16]");
            eger li > 0 {
                asm_yaz("    add x1, x1, #" + metine(li * 8));
            }
            asm_yaz("    str x0, [x1]");
            li = li + 1;
        }
        asm_yaz("    ldp x0, x1, [sp], #16");
        don 0;
    }
    eger dt == "INDEX" {
        // ifade = [INDEKS_AL, liste_ifade, index_ifade]
        degisken taban = ifade[1];
        eger (taban[0] == "ID" ve degisken_tip_bul_tam(taban[1]) == "metin") veya taban[0] == "STR" {
            kodla_ifade(ifade[2]);          // index -> x0
            asm_yaz("    mov x21, x0");     // index'i kaydet
            eger taban[0] == "STR" {
                degisken sc_etiket = yeni_str_etiketi();
                asm_str_tanimla(sc_etiket, taban[1]);
                asm_yaz("    adr x0, " + sc_etiket);
            } yoksa {
                kodla_ifade(taban);         // string adresi -> x0
            }
            asm_yaz("    mov x1, x21");
            asm_yaz("    bl _zedin_str_chr");
            don 0;
        }
        kodla_ifade(ifade[2]);          // index -> x0
        asm_yaz("    mov x21, x0");     // index'i kaydet
        kodla_ifade(ifade[1]);          // liste adresi -> x0
        asm_yaz("    ldr x0, [x0, #16]"); // data ptr (heap struct)
        asm_yaz("    lsl x21, x21, #3"); // index * 8
        asm_yaz("    add x0, x0, x21");
        asm_yaz("    ldr x0, [x0]");
        don 0;
    }

    eger dt == "ATAMA" {
        degisken hedef = ifade[1];
        eger hedef[0] == "INDEX" {
            // liste[i] = deger
            kodla_ifade(ifade[2]);       // deger -> x0
            asm_yaz("    mov x22, x0");  // deger kaydet
            kodla_ifade(hedef[2]);       // index -> x0
            asm_yaz("    mov x21, x0");
            kodla_ifade(hedef[1]);       // liste adresi -> x0
            asm_yaz("    ldr x0, [x0, #16]"); // data ptr (heap struct)
            asm_yaz("    lsl x21, x21, #3");
            asm_yaz("    add x0, x0, x21");
            asm_yaz("    str x22, [x0]");
            don 0;
        }
        kodla_ifade(ifade[2]);
        eger hedef[0] == "ID" {
            degisken etiket = degisken_bul(hedef[1]);
            eger uzunluk(etiket) > 0 {
                eger etiket[0] == "_" ve uzunluk(etiket) > 8 ve etiket[1] == "_" {
                    degisken off_str = "";
                    degisken oi = 8;
                    iken oi < uzunluk(etiket) ve etiket[oi] != "_" {
                        off_str = off_str + etiket[oi];
                        oi = oi + 1;
                    }
                    asm_yaz("    str x0, [x29, #-" + off_str + "]");
                } yoksa {
                    asm_yaz("    adr x1, " + etiket);
                    asm_yaz("    str x0, [x1]");
                }
            }
        }
        don 0;
    }
    eger dt == "BINOP" {
        degisken op = ifade[1];
        eger op == "ve" {
            degisken ve_son = yeni_etiket();
            degisken ve_sifir = yeni_etiket();
            kodla_ifade(ifade[2]);
            asm_yaz("    cmp x0, #0");
            asm_yaz("    b.eq " + ve_sifir);
            kodla_ifade(ifade[3]);
            asm_yaz("    cmp x0, #0");
            asm_yaz("    cset x0, ne");
            asm_yaz("    b " + ve_son);
            asm_yaz(ve_sifir + ":");
            asm_yaz("    mov x0, #0");
            asm_yaz(ve_son + ":");
            don 0;
        }
        eger op == "veya" {
            degisken veya_son = yeni_etiket();
            degisken veya_bir = yeni_etiket();
            kodla_ifade(ifade[2]);
            asm_yaz("    cmp x0, #0");
            asm_yaz("    b.ne " + veya_bir);
            kodla_ifade(ifade[3]);
            asm_yaz("    cmp x0, #0");
            asm_yaz("    cset x0, ne");
            asm_yaz("    b " + veya_son);
            asm_yaz(veya_bir + ":");
            asm_yaz("    mov x0, #1");
            asm_yaz(veya_son + ":");
            don 0;
        }
        kodla_ifade(ifade[2]);
        asm_yaz("    mov x22, x0");
        kodla_ifade(ifade[3]);
        asm_yaz("    mov x23, x0");
        asm_yaz("    mov x0, x22");
        eger op == "+" { asm_yaz("    add x0, x0, x23"); }
        eger op == "-" { asm_yaz("    sub x0, x0, x23"); }
        eger op == "*" { asm_yaz("    mul x0, x0, x23"); }
        eger op == "/" { asm_yaz("    sdiv x0, x0, x23"); }
        eger op == "%" {
            asm_yaz("    sdiv x24, x22, x23");
            asm_yaz("    msub x0, x24, x23, x22");
        }
        don 0;
    }
    don 0;
}

fonk kodla_stmt(stmt) {
    eger stmt == bos { don 0; }
    degisken st = stmt[0];

    eger st == "DEGISKEN" {
        degisken isim = stmt[1];
        degisken ifade_tipi = "sayi";
        eger uzunluk(stmt) > 2 ve stmt[2] != bos {
            eger stmt[2][0] == "STR" { ifade_tipi = "metin"; }
            yoksa eger stmt[2][0] == "LISTE" { ifade_tipi = "liste"; }
            yoksa eger ifade_metin_mi(stmt[2]) { ifade_tipi = "metin"; }
        }
        degisken etiket = degisken_ekle_tipli(isim, ifade_tipi);
        kodla_ifade(stmt[2]);
        eger etiket == "__yerel__" {
            asm_yaz("    str x0, [x29, #-" + metine(_yerel_offset) + "]");
        } yoksa {
            asm_yaz("    adr x1, " + etiket);
            asm_yaz("    str x0, [x1]");
        }
        don 0;
    }

    eger st == "YAZ" {
        degisken ifade = stmt[1];
        eger ifade[0] == "STR" {
            degisken etiket = yeni_str_etiketi();
            asm_str_tanimla(etiket, ifade[1]);
            asm_puts(etiket);
        } yoksa {
            eger ifade[0] == "ID" {
                degisken var_tipi = degisken_tip_bul(ifade[1]);
                eger var_tipi == "metin" {
                    degisken var_etiket = degisken_bul(ifade[1]);
                    asm_yaz("    adr x1, " + var_etiket);
                    asm_yaz("    ldr x0, [x1]");
                    asm_yaz("    bl puts");
                } yoksa {
                    kodla_ifade(ifade);
                    asm_yaz("    mov x19, x0");
                    asm_yaz("    adr x0, _fmt_sayi");
                    asm_yaz("    mov x1, x19");
                    asm_yaz("    bl printf");
                }
            } yoksa {
                eger ifade[0] != "BINOP" ve ifade_metin_mi(ifade) {
                    kodla_ifade(ifade);
                    asm_yaz("    bl puts");
                } yoksa eger ifade[0] == "BINOP" ve ifade[1] == "+" ve (ifade_metin_mi(ifade[2]) veya ifade_metin_mi(ifade[3])) {
                    // String birlestirme: sol + sag
                    degisken sol = ifade[2];
                    degisken sag = ifade[3];
                    // Sol tarafi x19'a yukle
                    eger sol[0] == "STR" {
                        degisken se = yeni_str_etiketi();
                        asm_str_tanimla(se, sol[1]);
                        asm_yaz("    adr x19, " + se);
                    } yoksa {
                        eger sol[0] == "ID" {
                            degisken sol_etiket = degisken_bul(sol[1]);
                            asm_yaz("    adr x1, " + sol_etiket);
                            asm_yaz("    ldr x19, [x1]");
                        } yoksa {
                            kodla_ifade(sol);
                            asm_yaz("    mov x19, x0");
                        }
                    }
                    // Sag tarafi x20'ye yukle
                    eger sag[0] == "STR" {
                        degisken se2 = yeni_str_etiketi();
                        asm_str_tanimla(se2, sag[1]);
                        asm_yaz("    adr x20, " + se2);
                        // str+str: printf ile yaz
                        asm_yaz("    adr x0, _fmt_str_str");
                        asm_yaz("    mov x1, x19");
                        asm_yaz("    mov x2, x20");
                        asm_yaz("    bl printf");
                    } yoksa {
                        eger sag[0] == "ID" {
                            degisken var_tipi2 = degisken_tip_bul(sag[1]);
                            eger var_tipi2 == "metin" {
                                degisken sag_etiket = degisken_bul(sag[1]);
                                asm_yaz("    adr x1, " + sag_etiket);
                                asm_yaz("    ldr x20, [x1]");
                                asm_yaz("    adr x0, _fmt_str_str");
                                asm_yaz("    mov x1, x19");
                                asm_yaz("    mov x2, x20");
                                asm_yaz("    bl printf");
                            } yoksa {
                                kodla_ifade(sag);
                                asm_yaz("    mov x20, x0");
                                asm_yaz("    adr x0, _fmt_str_sayi");
                                asm_yaz("    mov x1, x19");
                                asm_yaz("    mov x2, x20");
                                asm_yaz("    bl printf");
                            }
                        } yoksa {
                            kodla_ifade(sag);
                            asm_yaz("    mov x20, x0");
                            asm_yaz("    adr x0, _fmt_str_sayi");
                            asm_yaz("    mov x1, x19");
                            asm_yaz("    mov x2, x20");
                            asm_yaz("    bl printf");
                        }
                    }
                } yoksa {
                    kodla_ifade(ifade);
                    asm_yaz("    mov x19, x0");
                    asm_yaz("    adr x0, _fmt_sayi");
                    asm_yaz("    mov x1, x19");
                    asm_yaz("    bl printf");
                }
            }
        }
        don 0;
    }

    eger st == "EGER" {
        degisken kosul = stmt[1];
        degisken then_blok = stmt[2][1];
        degisken else_blok = stmt[3][1];
        degisken etiket_else = yeni_etiket();
        degisken etiket_son = yeni_etiket();

        // Kosulu hesapla (BINOP karsilastirma olmali)
        eger kosul[0] == "BINOP" ve (ifade_metin_mi(kosul[2]) veya ifade_metin_mi(kosul[3])) ve (kosul[1] == "==" veya kosul[1] == "!=") {
            kodla_ifade(kosul[2]);
            asm_yaz("    mov x19, x0");
            kodla_ifade(kosul[3]);
            asm_yaz("    mov x1, x0");
            asm_yaz("    mov x0, x19");
            asm_yaz("    bl strcmp");
            asm_yaz("    cmp x0, #0");
            eger kosul[1] == "==" {
                asm_yaz("    b.ne " + etiket_else);
            } yoksa {
                asm_yaz("    b.eq " + etiket_else);
            }
        } yoksa eger kosul[0] == "BINOP" ve (kosul[1] == "==" veya kosul[1] == "!=" veya kosul[1] == "<" veya kosul[1] == ">" veya kosul[1] == "<=" veya kosul[1] == ">=") {
            kodla_ifade(kosul[2]);
            asm_yaz("    mov x22, x0");
            kodla_ifade(kosul[3]);
            asm_yaz("    cmp x22, x0");
            asm_yaz("    " + ters_dal(kosul[1]) + " " + etiket_else);
        } yoksa {
            kodla_ifade(kosul);
            asm_yaz("    cmp x0, #0");
            asm_yaz("    b.eq " + etiket_else);
        }

        // Then blogu
        degisken ti = 0;
        iken ti < uzunluk(then_blok) {
            kodla_stmt(then_blok[ti]);
            ti = ti + 1;
        }
        asm_yaz("    b " + etiket_son);

        // Else blogu
        asm_yaz(etiket_else + ":");
        degisken ei = 0;
        iken ei < uzunluk(else_blok) {
            kodla_stmt(else_blok[ei]);
            ei = ei + 1;
        }
        asm_yaz(etiket_son + ":");
        don 0;
    }

    eger st == "IKEN" {
        degisken dongu_bas = yeni_etiket();
        degisken dongu_son = yeni_etiket();
        ekle(_dongu_etiketler, [dongu_bas, dongu_son]);
        degisken kosul = stmt[1];
        degisken govde = stmt[2][1];

        asm_yaz(dongu_bas + ":");

        // Kosul kontrolu
        eger kosul[0] == "BINOP" ve (ifade_metin_mi(kosul[2]) veya ifade_metin_mi(kosul[3])) ve (kosul[1] == "==" veya kosul[1] == "!=") {
            kodla_ifade(kosul[2]);
            asm_yaz("    mov x19, x0");
            kodla_ifade(kosul[3]);
            asm_yaz("    mov x1, x0");
            asm_yaz("    mov x0, x19");
            asm_yaz("    bl strcmp");
            asm_yaz("    cmp x0, #0");
            eger kosul[1] == "==" {
                asm_yaz("    b.ne " + dongu_son);
            } yoksa {
                asm_yaz("    b.eq " + dongu_son);
            }
        } yoksa eger kosul[0] == "BINOP" ve (kosul[1] == "==" veya kosul[1] == "!=" veya kosul[1] == "<" veya kosul[1] == ">" veya kosul[1] == "<=" veya kosul[1] == ">=") {
            kodla_ifade(kosul[2]);
            asm_yaz("    mov x22, x0");
            kodla_ifade(kosul[3]);
            asm_yaz("    cmp x22, x0");
            asm_yaz("    " + ters_dal(kosul[1]) + " " + dongu_son);
        } yoksa {
            kodla_ifade(kosul);
            asm_yaz("    cmp x0, #0");
            asm_yaz("    b.eq " + dongu_son);
        }

        // Govde
        degisken gi = 0;
        iken gi < uzunluk(govde) {
            kodla_stmt(govde[gi]);
            gi = gi + 1;
        }
        asm_yaz("    b " + dongu_bas);
        asm_yaz(dongu_son + ":");
        cikar(_dongu_etiketler, uzunluk(_dongu_etiketler) - 1);
        don 0;
    }

    eger st == "KIR" {
        eger uzunluk(_dongu_etiketler) > 0 {
            asm_yaz("    b " + _dongu_etiketler[uzunluk(_dongu_etiketler) - 1][1]);
        }
        don 0;
    }

    eger st == "DEVAM" {
        eger uzunluk(_dongu_etiketler) > 0 {
            asm_yaz("    b " + _dongu_etiketler[uzunluk(_dongu_etiketler) - 1][0]);
        }
        don 0;
    }

    eger st == "IFADE" {
        kodla_ifade(stmt[1]);
        don 0;
    }

    eger st == "FONK" {
        degisken fn_isim = stmt[1];
        degisken fn_params = stmt[2];
        degisken fn_govde = stmt[3][1];
        degisken eski_asm = _asm_satirlar;
        degisken eski_yerel = _yerel_degiskenler;
        degisken eski_offset = _yerel_offset;
        _asm_satirlar = [];
        _yerel_mod = tuz;
        _yerel_degiskenler = [];
        _yerel_offset = 0;
        // Parametreleri yerel degisken olarak kaydet
        degisken pi = 0;
        iken pi < uzunluk(fn_params) {
            _yerel_offset = _yerel_offset + 8;
            ekle(_yerel_degiskenler, [fn_params[pi], _yerel_offset, "sayi"]);
            pi = pi + 1;
        }
        // Once govdeyi derle (yerel offset'i bulmak icin)
        degisken govde_asm = [];
        degisken gi = 0;
        iken gi < uzunluk(fn_govde) {
            kodla_stmt(fn_govde[gi]);
            gi = gi + 1;
        }
        // Stack boyutunu 16'ya hizala
        degisken frame_boyut = (_yerel_offset + 15) - ((_yerel_offset + 15) % 16) + 16;
        // Sonra baslik ekle
        degisken govde_satirlar = _asm_satirlar;
        _asm_satirlar = [];
        asm_yaz("");
        asm_yaz(fn_isim + ":");
        asm_yaz("    stp x29, x30, [sp, #-" + metine(frame_boyut) + "]!");
        asm_yaz("    mov x29, sp");
        // Parametreleri stack'e yaz
        pi = 0;
        iken pi < uzunluk(fn_params) {
            asm_yaz("    str x" + metine(pi) + ", [x29, #-" + metine((pi + 1) * 8) + "]");
            pi = pi + 1;
        }
        // Govde satirlarini ekle
        degisken gsi = 0;
        iken gsi < uzunluk(govde_satirlar) {
            asm_yaz(govde_satirlar[gsi]);
            gsi = gsi + 1;
        }
        asm_yaz("    ldp x29, x30, [sp], #" + metine(frame_boyut));
        asm_yaz("    ret");
        degisken fsi = 0;
        iken fsi < uzunluk(_asm_satirlar) {
            ekle(_fonk_satirlar, _asm_satirlar[fsi]);
            fsi = fsi + 1;
        }
        _asm_satirlar = eski_asm;
        _yerel_mod = ters;
        _yerel_degiskenler = eski_yerel;
        _yerel_offset = eski_offset;
        don 0;
    }

    eger st == "DON" {
        degisken eski_offset2 = _yerel_offset;
        degisken frame_boyut2 = (eski_offset2 + 15) - ((eski_offset2 + 15) % 16) + 16;
        kodla_ifade(stmt[1]);
        asm_yaz("    ldp x29, x30, [sp], #" + metine(frame_boyut2));
        asm_yaz("    ret");
        don 0;
    }

    don 0;
}

fonk asm_uret(ast_ham) {
    // parse() artik ["PROGRAM", stmtler] donuyor - gercek listeyi cikar
    degisken ast = ast_ham;
    eger uzunluk(ast_ham) == 2 ve ast_ham[0] == "PROGRAM" {
        ast = ast_ham[1];
    }
    _asm_satirlar = [];
    _veri_satirlar = [];
    _degisken_satirlar = [];
    _fonk_satirlar = [];
    _str_sayac = 0;
    _etiket_sayac = 0;
    _yerel_mod = ters;
    _yerel_degiskenler = [];
    _yerel_offset = 0;
    _dongu_etiketler = [];

    asm_baslik();

    degisken i = 0;
    iken i < uzunluk(ast) {
        kodla_stmt(ast[i]);
        i = i + 1;
    }

    asm_son();

    // Tum satirlari birlestir
    degisken sonuc = [];
    degisken ai = 0;
    iken ai < uzunluk(_asm_satirlar) {
        ekle(sonuc, _asm_satirlar[ai]);
        ai = ai + 1;
    }
    degisken vi = 0;
    iken vi < uzunluk(_veri_satirlar) {
        ekle(sonuc, _veri_satirlar[vi]);
        vi = vi + 1;
    }
    don sonuc;
}

fonk zedin_asm_derle(kaynak_dosya, cikti_dosya) {
    yaz "Okunuyor: " + kaynak_dosya;
    degisken icerik_sonuc = oku_dosya(kaynak_dosya);
    eger hata_mi(icerik_sonuc) {
        yaz "Hata: " + mesaj_al(icerik_sonuc);
        don ters;
    }
    degisken kaynak = deger_al(icerik_sonuc);
    yaz "Taranıyor...";
    degisken tokenlar = tara(kaynak);
    yaz "Parse ediliyor...";
    degisken ast = parse(tokenlar);
    yaz "ARM64 Assembly uretiliyor...";
    degisken satirlar = asm_uret(ast);

    // .s dosyasina yaz
    byte_dosya_temizle(cikti_dosya);
    degisken si = 0;
    iken si < uzunluk(satirlar) {
        degisken satir = satirlar[si] + "\n";
        degisken ci = 0;
        iken ci < uzunluk(satir) {
            byte_yaz(cikti_dosya, char_kodu(satir[ci]));
            ci = ci + 1;
        }
        si = si + 1;
    }
    yaz "Assembly dosyasi olusturuldu: " + cikti_dosya;
    don tuz;
}
