{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zedin",
  "scopeName": "source.zedin",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zedin",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.zedin",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.zedin",
          "match": "\\\\(n|t|\\\\|\")"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.zedin",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.zedin",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zedin",
          "match": "\\b(eger|yoksa|iken|don|kir|devam)\\b"
        },
        {
          "name": "keyword.declaration.zedin",
          "match": "\\b(degisken|fonk|aktar)\\b"
        },
        {
          "name": "keyword.operator.logical.zedin",
          "match": "\\b(ve|veya|degil)\\b"
        },
        {
          "name": "keyword.other.zedin",
          "match": "\\byaz\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.zedin",
          "match": "(?<=:\\s|->\\s?)\\b(sayi|metin|mantik|liste|bos)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.zedin",
          "match": "\\b(tuz|ters)\\b"
        },
        {
          "name": "constant.language.null.zedin",
          "match": "\\bbos\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.zedin",
          "match": "(?<=fonk\\s)[a-zA-Zğüşıöçİ_][a-zA-Z0-9ğüşıöçİ_]*"
        },
        {
          "name": "support.function.zedin",
          "match": "\\b(uzunluk|ekle|cikar|sayiya|metine|tip|tamam|hata|tamam_mi|hata_mi|deger_al|mesaj_al|oku_dosya|yaz_dosya|parcala|birlestir|icerir|kirp|sirala|toplam|maksimum|minimum)\\b(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.zedin",
          "match": "->"
        },
        {
          "name": "keyword.operator.question.zedin",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.comparison.zedin",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.zedin",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.zedin",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    }
  }
}

